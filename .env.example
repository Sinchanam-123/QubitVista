# QubitVista — configuration for running the two halves somewhere other than
# one developer's laptop. Committed as a reference; .env files themselves are
# gitignored.
#
# NOTHING HERE IS REQUIRED LOCALLY. With both variables unset the frontend
# talks to http://localhost:8000 and the backend allows the two dev servers,
# which is exactly what `npm run dev` plus `uvicorn main:app` already do.
# They exist for a split deploy, where the two halves sit on different domains
# and neither can guess the other's address.


# ----------------------------------------------------------------- frontend
#
# Where the browser should look for the API.
#
# Read by Vite at BUILD time and inlined into the bundle, so it belongs in
# frontend/.env (or the build environment of whatever hosts the static files),
# and changing it needs a rebuild rather than a restart. No trailing slash.
#
# Unset means http://localhost:8000 — see API_BASE in frontend/src/utils/api.js.
#
# The frontend is usable with no backend at all: the simulator runs on the
# in-browser engine and the catalogue, concepts, gate cards and built-in
# circuit notes come from the generated copy in frontend/src/data. Only the
# written notes for a circuit the user builds themselves need the API.

VITE_API_BASE=http://localhost:8000


# ------------------------------------------------------------------ backend
#
# Comma-separated browser origins allowed to call the API.
#
# Read at process START, so a change needs a restart. An origin is scheme,
# host and port — no path, no trailing slash — and every origin the frontend
# is served from has to be listed, including the www and non-www forms if both
# resolve. Blank entries are ignored.
#
# Unset means the dev servers: http://localhost:5173,http://localhost:3000
#
# `*` works but is a poor idea here: this API is called with credentials
# enabled, and an allow-list is one line either way.

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
